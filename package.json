  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "verify": "npm run check && npm run build && npm run test:e2e && npm run check:docs",
    "check:docs": "node scripts/checks/docs.mjs",
    "check:live": "tsx scripts/devnet/health.ts",
    "demo:fixtures": "tsx scripts/devnet/cycle.ts",
    "test:program": "tsx tests/program/cycle.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0",
    "buffer": "6.0.3",
    "lucide-react": "1.48.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@solana/spl-token": "0.4.15",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "overrides": {
    "@solana/web3.js@1.98.4": {
      "rpc-websockets": "9.3.8"
    },
    "bn.js": "5.2.5"
  }
